<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DisneyPlusDesktop</RootNamespace>
    <AssemblyName>DisneyPlus</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.1</Version>
    <!-- Shown as the process name in Task Manager. -->
    <AssemblyTitle>Disney+</AssemblyTitle>
    <Product>Disney+ Desktop</Product>
    <Description>Disney+ web player with subtitle styling, playback speed, widescreen fill and high quality</Description>

    <!-- Publish as one portable exe (no .NET install needed). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <!-- Subtitle styling, widescreen fill and the settings drawer, injected into the Disney+ page. -->
    <EmbeddedResource Include="player.js" LogicalName="player.js" />
  </ItemGroup>

  <!-- WinForms app: drop the WebView2 WPF assembly the package adds (avoids a WindowsBase conflict). -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
